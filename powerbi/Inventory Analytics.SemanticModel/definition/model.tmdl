model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Date", "Product", "Location", "Stock", "Movements", "Goods Receipts", "KPI"]

ref table Date
ref table Product
ref table Location
ref table Stock
ref table Movements
ref table 'Goods Receipts'
ref table KPI

ref cultureInfo en-US

