model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Date", "Product", "Location", "Customer", "Channel", "Market", "Sales", "Target", "KPI"]

ref table Date
ref table Product
ref table Location
ref table Customer
ref table Channel
ref table Market
ref table Sales
ref table Target
ref table KPI

ref cultureInfo en-US

