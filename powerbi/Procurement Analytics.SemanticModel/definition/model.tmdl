model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Date", "Product", "Location", "Supplier", "Purchase Orders", "PO Lines", "Shipments", "Landed Cost", "Goods Receipts", "KPI"]

ref table Date
ref table Product
ref table Location
ref table Supplier
ref table 'Purchase Orders'
ref table 'PO Lines'
ref table Shipments
ref table 'Landed Cost'
ref table 'Goods Receipts'
ref table KPI

ref cultureInfo en-US

